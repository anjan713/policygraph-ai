# GCP project settings
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Storage. Use both: local for dev cache, GCS for production-style persisted object storage.
USE_GCS=false
GCS_BUCKET=policygraph-dev-uploads
GCS_PREFIX=policygraph/uploads

# Backend data stores
DATABASE_URL=postgresql+psycopg://policygraph:policygraph@localhost:5432/policygraph
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=policygraph-password
USE_NEO4J=true
VECTOR_DIMENSION=384

# PaddleOCR
OCR_ENGINE=paddleocr
PADDLEOCR_LANG=en
OCR_RENDER_DPI=200

# Optional Vertex AI upgrade path
VERTEX_AI_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_LLM_MODEL=gemini-1.5-flash

CORS_ORIGINS=http://localhost:3000
